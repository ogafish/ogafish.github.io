          <mxGeometry height="80" width="240" x="930" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="-9eMQAmwF-Dwq-j7aN0i-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="要做跨时间教学解释关系融合，需要先分析当前基线的不足，操作上一个是看论文一个是具体检验试验，极限方法对于教学视频所得到的产物是否有漏洞，或者其不适配教学领域且有某些针对教育视频特殊性的点无法做好，这里需要比较充足的证据和论述" vertex="1">
          <mxGeometry height="80" width="300" x="810" y="1250" as="geometry" />
        </mxCell>
